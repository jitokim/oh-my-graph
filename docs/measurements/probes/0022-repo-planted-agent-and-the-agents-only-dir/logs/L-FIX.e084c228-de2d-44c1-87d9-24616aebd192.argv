['-p', 'Render the note below into `design.html` — a standalone single-file HTML page — in the current working directory.\n\n# Job runner scheduling\n\nA small local job runner executes short-lived jobs submitted from a CLI. Jobs are\nIO-bound, arrive in bursts, and must not outlive the process that started them.\nDecision: a worker pool, bounded to NCPU-2 workers.\n', '--output-format', 'json', '--permission-mode', 'dontAsk', '--setting-sources', '', '--plugin-dir', '/tmp/omg-repo-agent/run-fix/agents-plugin', '--agent', 'omg-probe-writer', '--allowedTools', 'Write', '--tools', 'Write', '--strict-mcp-config', '--disallowedTools', 'Bash,Edit,MultiEdit,NotebookEdit,WebFetch,WebSearch,Task,Agent', '--session-id', 'e084c228-de2d-44c1-87d9-24616aebd192']
